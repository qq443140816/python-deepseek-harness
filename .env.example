# python-deepseek-harness 配置示例
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，密钥不落库不入日志。

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek 官方 API）=====
# 必填（llm_provider=openai 时）
PDSH_API_KEY=
PDSH_BASE_URL=https://api.deepseek.com
PDSH_MODEL=deepseek-chat
# openai = 真实 OpenAI 兼容接口；mock = 脚本回放（无 key 开发/测试）
PDSH_LLM_PROVIDER=openai
PDSH_LLM_TIMEOUT=120

# ===== 存储 =====
# 生产：MySQL（aiomysql 异步驱动）
PDSH_DB_URL=mysql+aiomysql://root:root@127.0.0.1:3306/pdsh
# 本地快速体验可用 SQLite：
# PDSH_DB_URL=sqlite+aiosqlite:///pdsh.db

# ===== Agent 行为护栏 =====
PDSH_MAX_ITERATIONS=25
PDSH_TOOL_TIMEOUT=60
PDSH_ASK_USER_TIMEOUT=600
PDSH_COMPACTION_THRESHOLD=8000

# ===== shell / fs 工具工作区边界 =====
PDSH_WORKSPACE=./workspace

# ===== 雪花 ID 机器位（0..1023，多实例部署时须各不相同）=====
PDSH_SNOWFLAKE_WORKER_ID=1
